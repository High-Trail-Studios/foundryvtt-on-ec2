# Foundry VTT distributions are licensed commercial software.
# Never commit them. You supply your own copy at build time.
FoundryVTT-*.zip
*.zip

# Local Foundry data (worlds, assets, config) — never commit.
data/
docker/data/

# Caddy certificates and ACME account keys — never commit.
docker/caddy/

# Local environment values (domain, ACME email) — never commit.
.env
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
# A stray file literally named "]" — an easy editor slip (`:w ]`) that saves a
# copy of real tfvars under a name *.tfvars does not catch.
\]
override.tf
override.tf.json
