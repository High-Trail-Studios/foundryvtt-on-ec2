# Copy to .env and fill in. .env is gitignored.

# Domain that resolves to this instance. Required — Let's Encrypt will not
# issue a certificate for a bare IP address.
FOUNDRY_DOMAIN=foundry.example.com

# Expiry and problem notices from Let's Encrypt go here.
ACME_EMAIL=you@example.com

# Image built by ./build.sh
FOUNDRY_IMAGE=foundryvtt:14.364

# On EC2 these point at the persistent EBS volume. Locally they default to
# ./data and ./caddy next to this file.
#FOUNDRY_DATA=/mnt/foundry/data
#CADDY_DATA=/mnt/foundry/caddy/data
#CADDY_STATE=/mnt/foundry/caddy/config
